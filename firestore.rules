rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if signedIn();
    }

    match /children/{childId} {
      allow read, write: if signedIn();
    }

    match /schedules/{id} {
      allow read, write: if signedIn();
    }

    match /behaviour_logs/{id} {
      allow read, write: if signedIn();
    }

    match /therapist_notes/{id} {
      allow read, write: if signedIn();
    }
  }
}
