rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    match /children/{childId} {
      allow read: if request.auth != null &&
        (resource.data.parentId == request.auth.uid || resource.data.therapistId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.parentId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.parentId == request.auth.uid || resource.data.therapistId == request.auth.uid);
    }

    // ponytail: schedules/logs/notes only check "is a signed-in app user", not
    // per-document ownership against /children (would need a get() lookup).
    // Tighten to real ownership checks once child<->schedule access matters
    // for more than one family in the same project.
    match /schedules/{id} {
      allow read, write: if request.auth != null;
    }
    match /behaviour_logs/{id} {
      allow read, write: if request.auth != null;
    }
    match /therapist_notes/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
